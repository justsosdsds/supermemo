    OnKeyPress = ListBox1KeyPress
  end
  object Panel1: TPanel
    Left = 0
    Top = 541
    Width = 837
    Height = 43
    Align = alBottom
    TabOrder = 1
    object InsertBtn: TButton
      Left = 118
      Top = 6
      Width = 106
      Height = 33
      Hint = 'Import images to image registry and insert them into the current element'
