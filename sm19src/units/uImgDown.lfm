    object OKBtn: TButton
      Left = 567
      Top = 4
      Width = 105
      Height = 33
      Hint = 'Close this dialog without taking any action'
      Caption = '&OK'
      TabOrder = 3
      OnClick = OKBtnClick
    end
    object DeleteBtn: TButton
      Left = 230
      Top = 4
      Width = 105
      Height = 33
      Hint = 'Delete selected images from the article (from the HTML source code)'
      Caption = '&Delete'
      TabOrder = 4
      OnClick = DeleteBtnClick
    end
    object ViewBtn: TButton
      Left = 342
      Top = 4
      Width = 107
      Height = 33
      Caption = 'View'
