  object PopupMenu1: TPopupMenu
    object MIScan: TMenuItem
      Caption = '&Uncheck duplicates'
      Hint = 'Scan URLs for duplicates and uncheck them'
      OnClick = MIUncheckDuplicates
    end
    object MIUncheckSelected: TMenuItem
