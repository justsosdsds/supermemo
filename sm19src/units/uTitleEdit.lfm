object TitleEdit: TTitleEdit
  Left = 406
  Top = 242
  BorderIcons = [biSystemMenu]
  Caption = 'Edit title'
  ClientHeight = 25
  ClientWidth = 509
  Color = clBtnFace
  DragKind = dkDock
  DragMode = dmAutomatic
  Font.Charset = DEFAULT_CHARSET
  Font.Color = clWindowText
  Font.Height = -11
  Font.Name = 'MS Sans Serif'
  Font.Style = []
  FormStyle = fsStayOnTop
  OnClose = FormClose
  OnCreate = FormCreate
  PixelsPerInch = 96
  object TitleMemo: TMemo
    Left = 40
    Top = 0
    Width = 469
    Height = 24
    Hint = 'New title for the current element'
    ParentShowHint = False
    ShowHint = True
    TabOrder = 0
    OnChange = TitleMemoChange
    OnKeyDown = TitleMemoKeyDown
  end
  object ButtonPanel: TPanel
    Left = 0
    Top = 0
    Width = 59
    Height = 25
    Align = alLeft
    TabOrder = 1
    object Save: TSpeedButton
      Left = 0
      Top = 0
      Width = 19
      Height = 18
      Hint = 'Save the currently edited title (Enter)'
      Flat = True
      Glyph.Data = {}
      ParentShowHint = False
      ShowHint = True
      OnClick = SaveClick
    end
    object CloseButton: TSpeedButton
      Left = 39
      Top = 0
      Width = 19
      Height = 18
      Hint = 'Quit without saving (Esc)'
      Flat = True
      Glyph.Data = {}
      ParentShowHint = False
      ShowHint = True
      OnClick = CloseButtonClick
    end
    object RestoreTitle: TSpeedButton
      Left = 20
      Top = 0
      Width = 18
      Height = 18
      Hint = 'Restore the previously saved title'
      Flat = True
      Glyph.Data = {}
      ParentShowHint = False
      ShowHint = True
      OnClick = RestoreTitleClick
    end
  end
end
